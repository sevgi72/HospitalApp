@model List<Doctor>
@{
	ViewData["Title"] = "Doctors";
}
<h1>Doctors</h1>
@if(Model.Count == 0)
{
	<p>No doctors found from the list</p>
}
else
{
	@foreach(var doctor in Model)
	{
		<div class="card mb-3">
			<div class="card-body">
				<h5 class="card-title">@doctor.Name</h5>
				<p class="card-text">Specialization: @doctor.Specialty</p>
			</div>
		</div>
	}
}
